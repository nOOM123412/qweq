# Скопируйте этот файл в .env для локального запуска (на Bothost переменные задаются в панели)

# --- Обязательные ---
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Токен @CryptoBot (Crypto Pay): https://t.me/CryptoBot -> Crypto Pay -> Create App
CRYPTO_TOKEN=000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Домен мини-аппа (Bothost выдаёт автоматически) ---
# Пример: https://bot-1793892401-9155-noom.bothost.tech
DOMAIN=
# Секрет для проверки вебхука (любая случайная строка, генерируется автоматически при деплое)
WEBHOOK_SECRET=

# --- Необязательные ---
ADMIN_IDS=123456789
SUPPORT_USERNAME=saiber
USD_TO_RUB=70
PORT=3000
DATA_DIR=./data
