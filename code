async def wa_index(request):
    p = os.path.join(WEBAPP_DIR, "index.html")
    if not os.path.exists(p):
        return web.Response(text="index.html не найден", status=404)
    return web.FileResponse(p)


async def wa_catalog(request):
    result = []
    for key, p in PRODUCTS.items():
        plans = []
        for plan in p["plans"]:
            plans.append({
                "code": plan["code"],
                "title": plan["title"],
                "desc": plan["desc"],
                "prices": {pd["code"]: get_price(plan["usd"], pd["months"]) for pd in PERIODS},
            })
        result.append({
            "key": key,
            "name": p["name"],
            "emoji": p["emoji"],
            "desc": p["desc"],
            "plans": plans,
        })
    return web.json_response({"products": result, "periods": PERIODS})


async def wa_buy(request):
    try:
        data = await request.json()
    except Exception:
        return web.json_response({"error": "bad json"}, status=400)

    user_id = data.get("user_id")
    amount = data.get("amount")
    title = data.get("title", "Подписка")

    if not user_id or not amount:
        return web.json_response({"error": "missing params"}, status=400)

    try:
        invoice = await crypto.create_invoice(
            amount=amount,
            fiat="RUB",
            currency_type="fiat",
            description=title,
            expires_in=3600,
        )
        pay_url = invoice.bot_invoice_url
        invoice_id = invoice.invoice_id
    except Exception as e:
        log.exception("crypto error")
        return web.json_response({"error": str(e)}, status=500)

    await db_create_topup(user_id, invoice_id, amount)
    return web.json_response({"pay_url": pay_url})


async def webapp_runner():
    app = web.Application()
    app.router.add_get("/", wa_index)
    app.router.add_get("/api/catalog", wa_catalog)
    app.router.add_post("/api/buy", wa_buy)

    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", WEBAPP_PORT)
    await site.start()
    print(f"🌐 Web App: http://localhost:{WEBAPP_PORT}")


async def start_webapp():
    try:
        await webapp_runner()
    except Exception as e:
        log.exception("webapp runner failed: %s", e)

